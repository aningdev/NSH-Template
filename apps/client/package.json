{
  "name": "@nsh-template/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nsh run App.tsx",
    "dev:macos": "nsh run App.tsx --target macos",
    "dev:windows": "nsh run App.tsx --target windows",
    "dev:linux": "nsh run App.tsx --target linux",
    "dev:web": "nsh run App.tsx --target web",
    "dev:gpui": "nsh run App.tsx --target gpui",
    "dev:mobile": "nsh run App.tsx --target catalyst",
    "dev:ios": "nsh run App.tsx --target ios",
    "dev:android": "nsh run App.tsx --target android",
    "dev:server": "nsh dev App.tsx --server-only",
    "check": "nsh check && nsh build",
    "package:macos": "nsh package --target macos --run",
    "package:windows": "nsh package --target windows",
    "package:linux": "nsh package --target linux",
    "package:web": "nsh package --target web",
    "package:gpui": "nsh package --target gpui",
    "package:ios": "nsh package --target ios",
    "package:android": "nsh package --target android",
    "test": "nsh test"
  }
}
